    "analyze": "ANALYZE=true webpack --mode=production",
    "analyze:dev": "ANALYZE=true webpack --mode=development",
    "analyze:stats": "webpack --mode=production --json > bundle-stats.json && webpack-bundle-analyzer bundle-stats.json",
