    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react|mpx-error-boundary)/)"
    ],
    "moduleNameMapper": {
      "@/(.*)": "<rootDir>/src/$1"
    },
    "testEnvironment": "jest-environment-jsdom",
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleFileExtensions": [
